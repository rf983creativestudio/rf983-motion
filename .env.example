# Copy to .env for local Docker Compose development.
RF983_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Replace with a long random secret. Never put this value in frontend code.
RF983_WORKER_TOKEN=replace-with-a-long-random-worker-secret
# Protects private machine diagnostics and operations history. Enter only in Model Lab.
RF983_OPERATIONS_TOKEN=replace-with-a-different-long-random-operations-secret
RF983_STATE_DB=./data/rf983-motion.sqlite3
RF983_MAX_BODY_BYTES=262144
